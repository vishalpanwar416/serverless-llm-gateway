# copy to .env, docker compose picks it up automatically

# mock mode = no keys needed
MOCK_MODE=true
# make a provider fail to test fallback: openai=429, openai=500, openai=timeout, openai=400
MOCK_FAILURES=

# routing / fallback
DEFAULT_PROVIDER=ollama
FALLBACK_TARGETS=ollama:llama3.2:1b
UPSTREAM_TIMEOUT_SECONDS=5

# ollama. use http://host.docker.internal:11434 if it's running on your machine instead of in docker
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_TIMEOUT_SECONDS=30

# real provider keys (optional), don't commit these
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# demo key that gets added to localstack
GATEWAY_DEMO_API_KEY=sk-gw-local-demo-key
